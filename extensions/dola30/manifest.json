{
  "manifest_version": 3,
  "name": "哆啦助手 · 30秒无水印助手",
  "short_name": "哆啦助手助手",
  "version": "1.6.12",
  "description": "哆啦助手：分辨率注入、成片捕获、无水印高清选源。提示词默认原文，秒数换算仍可手动打开。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "scripting",
    "downloads",
    "storage",
    "debugger"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.doubao.com/*",
        "*://*.dola.com/*"
      ],
      "js": [
        "media-capture-main.js",
        "model-selection-main.js",
        "skill-pack-main.js",
        "resolution-main.js",
        "resolution-native-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.dola.com/*"
      ],
      "js": [
        "media-upload-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.doubao.com/*",
        "*://*.dola.com/*"
      ],
      "js": [
        "duration-main.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.qianwen.com/*"
      ],
      "js": [
        "qianwen-media.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://xyq.jianying.com/*"
      ],
      "js": [
        "xyq-media.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.doubao.com/*",
        "*://*.dola.com/*",
        "*://*.qianwen.com/*",
        "*://*.jianying.com/*"
      ],
      "js": [
        "content-panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/doraemon.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "哆啦助手 · 30秒无水印助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
