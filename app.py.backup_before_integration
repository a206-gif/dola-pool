    c.execute("update tasks set status='queued',progress=0,result=null where id=?",(task_id,)); c.commit(); c.close(); TASK_QUEUE.put(task_id); audit('task.retry',task_id); return {'ok':True,'queue_depth':TASK_QUEUE.qsize()}

