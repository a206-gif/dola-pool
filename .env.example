# ===== Dola Pool 环境配置示例 =====
# 复制为 .env 后按需修改：cp .env.example .env
# （app.py 不依赖 python-dotenv，可用 `set -a; . ./.env; set +a` 载入，
#   或直接在 systemd/docker-compose 里配置 Environment）

# ---------- 基础 ----------
DOLA_HOST_BIND=0.0.0.0
DOLA_PORT=8000
DOLA_LOG_LEVEL=info
# 数据 / 成片 / 上传目录（默认都在仓库内 data/ 下）
# DOLA_DATA_DIR=./data
# DOLA_OUTPUT_DIR=./data/output
# DOLA_UPLOAD_DIR=./data/uploads
# DOLA_DB=./data/dola.db

# 管理令牌：设置后访问控制台需要令牌（登录页填写，或 URL 带 ?token=xxx）
# DOLA_ADMIN_TOKEN=change-me-please

# ---------- 运行模式 ----------
# 1 = 演示模式：不访问外网，任务使用内置示例成片，适合本地体验 / 演示 / 二次开发
DOLA_DEMO=1
# 演示模式下每个任务"生成"耗时（秒）
DOLA_DEMO_SECONDS=6

# ---------- 真实生成（演示模式关闭时生效）----------
# 可选：改为调用外部视频供应商接口，而不是本机 gen/dola_gen_clean.py
# VIDEO_PROVIDER_URL=https://your-provider.example.com/v1/videos
# VIDEO_PROVIDER_TOKEN=sk-xxxx

# 可选：统一出口代理（gen 模块内部还会按任务自动轮换住宅 IP）
# DOLA_PROXY=http://user:pass@proxy.example.com:6666
# DOLA_PROXY_REGION=台湾
# DOLA_PROXY_PROVIDER=udealproxy

# 代理刷新脚本（scripts/refresh-proxy.sh）读取的地址，配置后「刷新代理 IP」按钮才会真正执行
# DOLA_PROXY_REFRESH_URL=http://proxy.example.com:7777/update?custom=xxxx&session=xxxx

# ---------- 调度 ----------
VIDEO_MAX_CONCURRENCY=6
MAX_DAILY_PER_ACCOUNT=20

# ---------- AI 分镜推理（Agnes / 任意 OpenAI 兼容接口）----------
# 不配置则自动使用本地规则模板拆镜
# AGNES_API_KEY=sk-xxxx
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# AGNES_MODEL=agnes-3.0-flash

# ---------- 账号验活 ----------
# 账号"验活"调用的官方接口，可按需替换
# DOLA_ACCOUNT_CHECK_URL=https://www.dola.com/passport/account/info/v2/
