function startTaskPolling(){
  if(taskPollTimer)clearInterval(taskPollTimer);
  taskPollTimer=setInterval(async()=>{
    try{
      const tasks=await api('tasks');
      const data=story();let changed=false;
      for(let i=0;i<data.length;i++){
        const s=data[i];
        if(s.task_id){
          const t=tasks.find(x=>x.id===s.task_id);
          if(t){
            if(t.status==='completed'&&s.status!=='completed'){
              s.status='completed';s.progress=100;
              if(t.result&&t.result.includes('|')){
                const fname=t.result.split('|')[0].split('/').pop();
                s.result_url='/output/'+fname;
              }
              changed=true;toast('镜头 '+(i+1)+' 生成完成!');
            }else if(t.status==='failed'&&s.status!=='failed'){
              s.status='failed';s.error=t.result;changed=true;
            }else if(t.status==='running'&&s.status!=='running'){
              s.status='running';s.progress=t.progress||30;changed=true;
            }
          }
        }
      }
      if(changed){persistStory(data);renderScenes()}
      const hasRunning=data.some(s=>s.status==='running'||s.status==='queued');
      if(!hasRunning&&taskPollTimer){clearInterval(taskPollTimer);taskPollTimer=null}
    }catch(e){}
  },5000);
}

