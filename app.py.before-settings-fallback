  if(rb)rb.textContent='运行中 '+running;
});
}
function toast(msg){let t=document.getElementById('toast');if(!t){t=document.createElement('div');t.id='toast';t.className='toast';document.body.appendChild(t)}t.textContent=msg;t.classList.add('show');clearTimeout(window.__toast);window.__toast=setTimeout(()=>t.classList.remove('show'),2600)}
function topAction(kind){if(kind==='bind'){const x=story();x.forEach(s=>s.bound=true);persistStory(x);renderScenes();toast('镜头识别绑定已完成');return}if(kind==='mode'){toast('当前为视频模式');return}if(kind==='clear'){if(!confirm('清空全部本地分镜？'))return;localStorage.removeItem('dola_story');gen();toast('已清空分镜');}}
function searchReplace(){
  const find=prompt('搜索内容：');
  if(!find)return;
  const replace=prompt('替换为：','');
  if(replace===null)return;
  const data=story();
  let count=0;
  data.forEach(s=>{
    if(s.script&&s.script.includes(find)){s.script=s.script.replaceAll(find,replace);count++}
    if(s.prompt&&s.prompt.includes(find)){s.prompt=s.prompt.replaceAll(find,replace);count++}
  });
  persistStory(data);renderScenes();
  toast('已替换 '+count+' 处');
}
let filterFailedOnly=false;
function filterFailed(){
  filterFailedOnly=!filterFailedOnly;
  renderScenes();
  toast(filterFailedOnly?'只显示失败镜头':'显示全部镜头');
}
function sceneMore(i){const x=story()[i];toast('镜头 '+(i+1)+'：状态 '+(x.status||'ready')+'，时长 '+x.duration+' 秒')}
function openParams(){const model=document.getElementById('storyModel')?.value||'sd-2.5-30s';const x=prompt('当前模型：'+model+'\n输入默认画质（720p/1080p）：','720p');if(x){localStorage.setItem('dola_quality',x);toast('参数已保存：'+x)}}
function importStoryboard(){
 const input=document.createElement('input'); input.type='file'; input.accept='.json,.txt';
 input.onchange=()=>{const f=input.files[0];if(!f)return;const reader=new FileReader();
  reader.onload=()=>{let data=[];try{data=JSON.parse(reader.result);if(!Array.isArray(data))data=[data]}catch(e){data=String(reader.result).split(/\r?\n/).filter(Boolean).map((prompt,i)=>({title:'镜头_'+(i+1),script:'',prompt,duration:15,status:'ready'}))}
   data=data.map((x,i)=>({title:x.title||'镜头_'+(i+1),script:x.script||'',prompt:x.prompt||'',duration:Number(x.duration)||15,status:x.status||'ready'}));persistStory(data);gen();toast('已导入 '+data.length+' 个镜头');
  }; reader.readAsText(f,'utf-8');
 }; input.click();
}
function story(){try{const v=JSON.parse(localStorage.getItem('dola_story')||'[]');return Array.isArray(v)?v:[]}catch(e){return []}}
function persistStory(v){localStorage.setItem('dola_story',JSON.stringify(v))}
function renderScenes(){
 const list=document.getElementById('sceneList');if(!list)return;const data=story();
 if(!data.length){list.innerHTML='<div class="empty">暂无镜头，点击“新增镜头”或“导入分镜”开始。</div>';return}
 list.innerHTML=data.map((s,i)=>`<article class="scene-card"><header><b class="scene-no">${String(i+1).padStart(2,'0')}</b><b>${esc(s.title||('镜头_'+(i+1)))}</b><span class="scene-actions"><button onclick="clearScene(${i})">清空场景参考</button><button onclick="duplicateScene(${i})">复制</button><button class="danger" onclick="deleteScene(${i})">删除</button></span></header><div class="scene-grid"><section><label>分镜原文</label><textarea data-field="script" data-index="${i}" placeholder="这里放这个镜头的原始分镜文案">${esc(s.script||'')}</textarea></section><section><div class="prompt-head"><label>全局提示词</label><span><button onclick="addPrefix(${i})">前缀</button><button onclick="addSuffix(${i})">后缀</button><button onclick="showAssetPicker(${i})">@资产</button><button onclick="aiReasonScene(${i})">AI</button><button onclick="assetAction(${i},'更多')">更多</button></span></div><textarea data-field="prompt" data-index="${i}" placeholder="例如：电影级光影，真人物理质感，画面细节清晰，构图干净">${esc(s.prompt||'')}</textarea><div style="margin-top:8px"><label style="font-size:11px;color:#728184">参考图（最多9张，点击上传）</label><div id="refImages_${i}" class="ref-images">${(s.ref_images||[]).map((p,idx)=>'<div class="ref-img-item"><img src="'+p.replace('/opt/dola-pool','')+'" onclick="removeRefImage('+i+','+idx+')"><span class="ref-del">×</span></div>').join('')}<label class="ref-add" onclick="document.getElementById('refInput_'+${i}).click()">+</label><input type="file" id="refInput_${i}" accept="image/*" multiple style="display:none" onchange="uploadRefImages(${i},this.files)"></div></div></section><section><div class="preview-tools"><button onclick="regenerateScene(${i})">重新生成</button><button onclick="downloadScene(${i})">下载视频</button><button onclick="previewScene(${i})">放大查看</button><button onclick="sceneMore(${i})">更多</button></div><div class="video-preview"><div class="preview-label">预览区 · ${esc(s.status==='completed'?'已完成':s.status==='queued'?'排队中':s.status==='failed'?'失败':'已准备')}</div><div class="preview-art">${s.result_url?'<video controls preload="metadata" style="max-width:100%;max-height:100%" src="'+esc(s.result_url)+'"></video>':'<span style="text-align:center">视频预览<br><small>生成后自动显示<br>状态: '+esc(s.status||'ready')+'</small></span>'}</div></div><div class="timeline"><span>任务 ${esc(s.task_id||'未提交')} · ${Number(s.duration)||15}s · ${esc(s.status||'ready')}</span>${s.status==='running'?'<i>生成中<small>'+(s.progress||0)+'%</small></i>':s.status==='completed'?'<i style="background:#0a5c3a">完成<small>100%</small></i>':s.status==='failed'?'<i class="bad">失败</i>':'<i>等待<small>0%</small></i>'}</div></section></div><footer>资产库：开启　导航图、角色、场景、道具按项目配置　<select data-field="duration" data-index="${i}"><option value="10" ${Number(s.duration)===10?'selected':''}>10</option><option value="15" ${Number(s.duration)===15?'selected':''}>15</option><option value="30" ${Number(s.duration)===30?'selected':''}>30</option></select>s</footer></article>`).join('');
 list.querySelectorAll('[data-field]').forEach(el=>el.addEventListener('change',()=>updateScene(Number(el.dataset.index),el.dataset.field,el.value)));
