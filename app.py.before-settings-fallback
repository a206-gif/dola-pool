  // 填充账号选择下拉框
  const accSel=document.getElementById('accountSelect');
  if(accSel&&a.length){
    a.forEach(acc=>{
      if(acc.status==='active'||acc.status==='ready'){
        const opt=document.createElement('option');
        opt.value=acc.id;
        opt.textContent=(acc.name||'账号'+acc.id)+' ('+(acc.status||'未知')+')';
        accSel.appendChild(opt);
      }
    });
  }
  // 更新运行中数量
  const running=t.filter(x=>x.status==='running'||x.status==='queued').length;
