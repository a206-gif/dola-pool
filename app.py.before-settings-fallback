async function render(){document.querySelectorAll('nav button').forEach(b=>b.classList.toggle('active',b.dataset.page==page));if(page==='generate')return gen(); if(page==='import')return importPage(); let data=await api(page==='keys'?'api_keys':page); let heads=data[0]?Object.keys(data[0]):[]; C.innerHTML='<div class="panel"><div class="toolbar"><input placeholder="搜索" id="search"><button class="primary" onclick="addRow()">+ 新增</button></div><table><thead><tr>'+heads.map(h=>'<th>'+h+'</th>').join('')+'</tr></thead><tbody>'+data.map(r=>'<tr>'+heads.map(h=>'<td>'+((r[h]??'')+'').replaceAll('<','&lt;')+'</td>').join('')+'</tr>').join('')+'</tbody></table></div>'}
function gen(){
 const saved=JSON.parse(localStorage.getItem('dola_story')||'null')||[{title:'镜头_1',script:'这里放这个镜头的原始分镜文案',prompt:'二牛和一只小猫在跑步',duration:15,status:'ready'},{title:'镜头_1_副本',script:'这里放这个镜头的原始分镜文案',prompt:'沙漠中远处的队伍缓慢前行',duration:15,status:'ready'}];
 localStorage.setItem('dola_story',JSON.stringify(saved));
  C.innerHTML='<div class="story-top"><div><b>分镜进度</b> <span id="storyProgress">1/'+saved.length+'</span> <span class="badge" id="runningBadge">运行中 0</span> <button onclick="searchReplace()">搜索替换</button> <button onclick="filterFailed()">筛选失败</button> <button onclick="topAction(\'bind\')">识别绑定</button> <button class="active" onclick="topAction(\'mode\')">视频模式</button> <button onclick="topAction(\'clear\')">清除</button> <button onclick="importStoryboard()">导入分镜</button> <button onclick="exportStory()">导出</button> <button onclick="aiReason()">AI推理</button></div><div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap"><label style="font-size:12px;color:#9aabad">账号</label><select id="accountSelect" style="min-width:140px"><option value="">智能选号</option></select><label style="font-size:12px;color:#9aabad"><input type="checkbox" id="removeWm" checked> 去水印</label><select id="storyModel"><option value="seedance_v2.5|30">官方SD2.5 (30秒)</option><option value="seedance_v2.0|15">SD2.0 (15秒)</option><option value="seedance_v2.0|10">SD2.0 (10秒)</option></select><button onclick="openParams()">参数</button><button class="primary" onclick="batchGenerate()">批量生成</button></div></div><div id="sceneList"></div><button class="add-scene" onclick="newScene()">+ 新增镜头</button><div style="text-align:right;margin-top:10px;font-size:11px;color:#728184" id="autoSaveTime">自动保存中...</div>';
 renderScenes();
 Promise.all(['accounts','tasks','proxies'].map(x=>api(x))).then(([a,t,p])=>{
  const q=document.getElementById('storyProgress');
