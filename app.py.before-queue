from fastapi import FastAPI, Request, UploadFile, File, Form
from fastapi.responses import HTMLResponse, JSONResponse
from fastapi.staticfiles import StaticFiles
import sqlite3, json, csv, io, secrets, hashlib, datetime, os

DB = os.getenv('DOLA_DB', 'dola.db')
app = FastAPI(title='Dola Pool Operations')

def db():
    c=sqlite3.connect(DB); c.row_factory=sqlite3.Row; return c
def init():
    c=db(); c.executescript('''
    create table if not exists accounts(id integer primary key, name text, cookie text, status text default 'active', points integer default 0, created_at text);
    create table if not exists proxies(id integer primary key, host text, port integer, username text, password text, status text default 'unknown');
    create table if not exists tasks(id text primary key, prompt text, duration integer, ratio text, model text, account_id integer, status text, progress integer default 0, result text, created_at text);
    create table if not exists api_keys(id integer primary key, label text, key text, enabled integer default 1, created_at text);
    create table if not exists settings(k text primary key, v text);
    create table if not exists errors(id integer primary key, level text, message text, created_at text);
    create table if not exists audits(id integer primary key, action text, detail text, created_at text);
    '''); c.commit(); c.close()
    c=db()
    for stmt in ["alter table tasks add column quality text default '720p'", "alter table tasks add column min_bytes integer default 30000000"]:
        try: c.execute(stmt)
        except sqlite3.OperationalError: pass
    c.commit(); c.close()
init()

def now(): return datetime.datetime.utcnow().isoformat(timespec='seconds')+'Z'
def audit(action, detail=''):
    c=db(); c.execute('insert into audits(action,detail,created_at) values(?,?,?)',(action,detail,now())); c.commit(); c.close()
def rows(table):
    c=db(); r=[dict(x) for x in c.execute(f'select * from {table} order by rowid desc')]; c.close(); return r

@app.get('/api/{table}')
def list_table(table: str):
    if table not in {'accounts','proxies','tasks','api_keys','settings','errors','audits'}: return JSONResponse({'error':'bad table'},400)
    return [{k: ('••••••' if k in {'cookie','password','key'} and v else v) for k,v in r.items()} for r in rows(table)]

@app.post('/api/accounts')
async def add_account(request: Request):
    x=await request.json(); c=db(); c.execute('insert into accounts(name,cookie,points,created_at) values(?,?,?,?)',(x.get('name','Account'),x.get('cookie',''),x.get('points',0),now())); c.commit(); c.close(); audit('account.create',x.get('name','')); return {'ok':True}

@app.post('/api/import')
async def import_accounts(file: UploadFile=File(None), cookies: str=Form('')):
    text=cookies
    if file: text=(await file.read()).decode('utf-8-sig','ignore')
    items=[]
    try:
        if file and file.filename.lower().endswith('.json'): items=json.loads(text); items=items if isinstance(items,list) else [items]
        elif file and file.filename.lower().endswith('.csv'): items=list(csv.DictReader(io.StringIO(text)))
        else: items=[{'cookie':line.strip()} for line in text.splitlines() if line.strip()]
    except Exception as e: return JSONResponse({'error':str(e)},400)
    c=db()
    for i,x in enumerate(items):
        x = {'cookie': x} if isinstance(x,str) else x
        if not isinstance(x,dict): continue
        cookie=x.get('cookie') or x.get('cookies') or x.get('value') or str(x)
        name=x.get('name') or f'Imported {i+1}'; c.execute('insert into accounts(name,cookie,created_at) values(?,?,?)',(name,cookie,now()))
    c.commit(); c.close(); audit('account.import',str(len(items))); return {'ok':True,'count':len(items)}

@app.post('/api/proxies')
async def add_proxy(request: Request):
    x=await request.json(); c=db(); c.execute('insert into proxies(host,port,username,password) values(?,?,?,?)',(x['host'],x.get('port',8080),x.get('username',''),x.get('password',''))); c.commit(); c.close(); audit('proxy.create',x['host']); return {'ok':True}

@app.post('/api/tasks')
async def add_task(request: Request):
    x=await request.json(); tid=secrets.token_hex(6); duration=int(x.get('duration',30)); model=x.get('model','dola-video-2.5-30s')
    if duration not in (10,15,30): return JSONResponse({'error':'duration must be 10, 15 or 30 seconds'},400)
    c=db(); c.execute('insert into tasks(id,prompt,duration,ratio,model,account_id,status,quality,min_bytes,created_at) values(?,?,?,?,?,?,?,?,?,?)',(tid,x.get('prompt',''),duration,x.get('ratio','16:9'),model,x.get('account_id'),'awaiting_provider',x.get('quality','720p'),max(30000000,int(x.get('min_bytes',30000000))),now())); c.commit(); c.close(); audit('task.create',tid); return {'ok':True,'id':tid}

@app.post('/api/keys')
async def add_key(request: Request):
    x=await request.json(); key='dola_'+secrets.token_urlsafe(24); c=db(); c.execute('insert into api_keys(label,key,created_at) values(?,?,?)',(x.get('label','API key'),key,now())); c.commit(); c.close(); audit('key.create',x.get('label','')); return {'key':key}

@app.post('/api/settings')
async def save_settings(request: Request):
    x=await request.json()
    if not isinstance(x,dict): return JSONResponse({'error':'settings must be an object'},400)
    c=db()
    for k,v in x.items(): c.execute('insert into settings(k,v) values(?,?) on conflict(k) do update set v=excluded.v',(str(k),str(v)))
    c.commit(); c.close(); audit('settings.save'); return {'ok':True}

@app.delete('/api/{table}/{item}')
def delete_item(table: str, item: str):
    if table not in {'accounts','proxies','tasks','api_keys'}: return JSONResponse({'error':'invalid table'},400)
    c=db(); c.execute(f'delete from {table} where id=?',(item,)); c.commit(); c.close(); audit(table+'.delete',item); return {'ok':True}

@app.get('/', response_class=HTMLResponse)
def index(): return HTML

HTML = r'''<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Dola Pool</title><style>
*{box-sizing:border-box}body{margin:0;font:14px Inter,Arial;background:#141718;color:#e7eeee}aside{position:fixed;inset:0 auto 0 0;width:182px;background:#1d2e36;color:#b8c9cc;padding:18px 12px;border-right:1px solid #263d43}aside h2{font-size:17px;margin:0 8px 24px;color:#fff}nav button{display:block;width:100%;text-align:left;background:none;border:0;color:#b8c9cc;padding:13px 12px;border-radius:5px;font-size:14px;cursor:pointer}nav button.active,nav button:hover{background:#078d78;color:#fff}main{margin-left:182px;padding:28px 30px;background:#141718;min-height:100vh}.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;border-bottom:1px solid #2b3639;padding-bottom:16px}h1{font-size:22px;margin:0;color:#f3f8f7}.panel{background:#1c2021;border:1px solid #303b3e;border-radius:8px;padding:18px;margin-bottom:18px;box-shadow:0 10px 25px #0002}.toolbar{display:flex;gap:10px;margin-bottom:14px}input,select,textarea{border:1px solid #3a484b;background:#151819;color:#e7eeee;border-radius:4px;padding:9px;font:inherit}input::placeholder,textarea::placeholder{color:#708184}button.primary{background:#078d78;color:#fff;border:0;border-radius:4px;padding:9px 16px;cursor:pointer}button.primary:hover{background:#0ca58c}table{border-collapse:collapse;width:100%}th,td{text-align:left;padding:12px 10px;border-bottom:1px solid #2c3537}th{font-weight:600;color:#92a6a9}td{color:#d9e4e4}.badge{padding:4px 8px;border-radius:4px;background:#4b3517;color:#ffc56d}.modal{position:fixed;inset:0;background:#000b;display:none;align-items:center;justify-content:center}.modal>div{background:#f7faf9;color:#1d3035;width:620px;border-radius:8px;padding:24px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.stat{padding:14px;background:#183a35;border:1px solid #24685d;border-radius:6px;color:#c8e5df}.stat b{display:block;font-size:22px;margin-top:6px;color:#fff}.muted{color:#819396}.work{background:#181a1b;color:#eee;min-height:560px;border-radius:8px;padding:18px;border:1px solid #303638}.work textarea{background:#111;color:#eee;width:100%;height:130px;border-color:#343e40}.work .preview{height:260px;background:#050606;border:1px solid #2b3435;margin-top:14px;display:flex;align-items:center;justify-content:center;color:#718078}.story-top{display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;background:#1b1e1f;border:1px solid #303738;border-radius:8px;padding:12px;margin-bottom:14px}.story-top button,.story-top select{margin:3px}.story-top button.active{background:#f4f6f5;color:#111}.scene-card{background:#1b1d1e;border:1px solid #303739;border-radius:9px;padding:16px;margin-bottom:18px}.scene-card header{display:flex;align-items:center;gap:10px;margin-bottom:12px}.scene-no{font-size:34px;color:#45494a}.scene-actions{margin-left:auto}.scene-actions button{margin-left:5px}.danger{color:#ff8b87}.scene-grid{display:grid;grid-template-columns:1fr 1fr 1.08fr;gap:14px}.scene-grid section{min-width:0}.scene-grid label{display:block;color:#9aabad;margin-bottom:7px}.scene-grid textarea{width:100%;height:500px;resize:vertical;background:#111415}.prompt-head{display:flex;justify-content:space-between;align-items:center}.prompt-head button{font-size:11px;padding:5px}.shot-prompt{border:1px solid #303b3e;border-radius:6px;padding:10px;margin-top:10px;min-height:100px;color:#e7eeee}.preview-tools{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px}.preview-tools button{font-size:12px}.video-preview{height:500px;background:#050607;border:1px solid #303739;border-radius:7px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#849496}.preview-art{width:94%;height:78%;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#17231e,#253d2c 45%,#121716);text-align:center}.preview-art img{max-width:100%;max-height:100%}.preview-label{padding:7px}.timeline{display:flex;gap:5px;align-items:center;margin-top:8px;overflow:auto}.timeline span{font-size:11px;color:#8c999b;white-space:nowrap}.timeline i{font-style:normal;min-width:46px;padding:5px;text-align:center;border-radius:6px;background:#194c37;color:#7be2ad}.timeline i.bad{background:#4b2428;color:#ff9b98}.timeline small{display:block}.scene-card footer{color:#728184;padding-top:10px;font-size:12px}.add-scene{width:100%;padding:15px;background:#1b2525;border:1px dashed #347d6f;color:#7bd1be;border-radius:8px}.hidden{display:none}</style></head><body><aside><h2>▣ Dola Pool<small style="display:block;font-size:10px;color:#7fb8ad">OPERATIONS</small></h2><nav id="nav"> <button data-page="generate">✧　生成</button><button data-page="accounts">♧　账号</button><button data-page="proxies">♧　代理池</button><button data-page="import">⇧　导入</button><button data-page="tasks">☷　任务</button><button data-page="keys">⚿　密钥</button><button data-page="settings">☷　设置</button><button data-page="errors">◉　错误</button><button data-page="audits">◴　审计</button></nav></aside><main><div class="top"><h1 id="title">生成</h1><span class="muted">租约 <b id="lease">未连接</b></span></div><section id="content"></section></main><div class="modal" id="modal"><div><h2>导入账号</h2><p class="muted">Cookie，每行一个</p><textarea id="cookies" placeholder="sessionid=...; sid_guard=..." style="width:100%;height:170px"></textarea><p><input type="file" id="file" accept=".txt,.csv,.json"></p><div style="text-align:right"><button onclick="closeModal()">取消</button> <button class="primary" onclick="doImport()">⇧ 开始导入</button></div></div></div><script>
function esc(x){return String(x??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'}[c]))} const C=document.getElementById('content'), T=document.getElementById('title'); let page='generate';
async function api(path,opt){let r=await fetch('/api/'+path,opt);return r.json()}
function nav(){document.querySelectorAll('nav button').forEach(b=>b.onclick=()=>{page=b.dataset.page;T.textContent=b.textContent.trim();render()})}
async function render(){document.querySelectorAll('nav button').forEach(b=>b.classList.toggle('active',b.dataset.page==page));if(page==='generate')return gen(); if(page==='import')return importPage(); let data=await api(page==='keys'?'api_keys':page); let heads=data[0]?Object.keys(data[0]):[]; C.innerHTML='<div class="panel"><div class="toolbar"><input placeholder="搜索" id="search"><button class="primary" onclick="addRow()">+ 新增</button></div><table><thead><tr>'+heads.map(h=>'<th>'+h+'</th>').join('')+'</tr></thead><tbody>'+data.map(r=>'<tr>'+heads.map(h=>'<td>'+((r[h]??'')+'').replaceAll('<','&lt;')+'</td>').join('')+'</tr>').join('')+'</tbody></table></div>'}
function gen(){
 const saved=JSON.parse(localStorage.getItem('dola_story')||'null')||[{title:'镜头_1',script:'这里放这个镜头的原始分镜文案',prompt:'二牛和一只小猫在跑步',duration:15,status:'ready'},{title:'镜头_1_副本',script:'这里放这个镜头的原始分镜文案',prompt:'沙漠中远处的队伍缓慢前行',duration:15,status:'ready'}];
 localStorage.setItem('dola_story',JSON.stringify(saved));
 C.innerHTML='<div class="story-top"><div><b>分镜进度</b> <span id="storyProgress">1/'+saved.length+'</span>　<span class="badge">运行中 0</span> <button>搜查超时</button> <button>识别绑定</button> <button class="active">视频模式</button> <button>清除</button> <button onclick="importPage()">导入分镜</button></div><div><select id="storyModel"><option>漫影 - sd-2.5-30s</option><option>sd-2.0-15s</option><option>sd-2.0-10s</option></select><button>参数</button><button class="primary" onclick="batchGenerate()">批量生成</button><button onclick="exportStory()">导出剪辑</button></div></div><div id="sceneList"></div><button class="add-scene" onclick="newScene()">＋ 新增镜头</button>';
 renderScenes();
 Promise.all(['accounts','tasks','proxies'].map(x=>api(x))).then(([a,t,p])=>{const q=document.getElementById('storyProgress');if(q)q.textContent='1/'+saved.length+'　账号 '+a.length+'　任务 '+t.length+'　代理 '+p.length});
}
function story(){return JSON.parse(localStorage.getItem('dola_story')||'[]')}
function persistStory(x){localStorage.setItem('dola_story',JSON.stringify(x))}
function renderScenes(){const list=document.getElementById('sceneList');if(!list)return;const x=story();list.innerHTML=x.map((s,i)=>'<article class="scene-card"><header><b class="scene-no">'+String(i+1).padStart(2,'0')+'</b><b>'+esc(s.title)+'</b><span class="scene-actions"><button onclick="clearScene('+i+')">清空场景参考</button><button onclick="duplicateScene('+i+')">复制</button><button class="danger" onclick="deleteScene('+i+')">删除</button></span></header><div class="scene-grid"><section><label>分镜原文</label><textarea onchange="updateScene('+i+',\'script\',this.value)" placeholder="这里放这个镜头的原始分镜文案">'+esc(s.script)+'</textarea></section><section><div class="prompt-head"><label>全局提示词</label><span><button onclick="assetAction('+i+',\'场景参考\')">清空场景参考</button><button onclick="assetAction('+i+',\'资产\')">@资产</button><button onclick="assetAction('+i+',\'AI\')">AI</button><button onclick="assetAction('+i+',\'更多\')">更多</button></span></div><textarea onchange="updateScene('+i+',\'prompt\',this.value)" placeholder="例如：电影级光影，真人物理质感，画面细节清晰，构图干净">'+esc(s.prompt)+'</textarea><div class="shot-prompt">'+esc(s.prompt||'等待输入镜头提示词')+'</div></section><section><div class="preview-tools"><button onclick="regenerateScene('+i+')">重新生成</button><button onclick="downloadScene('+i+')">下载视频</button><button onclick="downloadScene('+i+')">放大查看</button><button>更多</button></div><div class="video-preview"><div class="preview-label">预览区 · '+esc(s.status==='ready'?'已准备':'待生成')+'</div><div class="preview-art">'+(s.image?'<img src="'+esc(s.image)+'">':'<span>视频预览<br><small>连接生成服务后显示结果</small></span>')+'</div></div><div class="timeline"><span>seedance... '+s.duration+'s</span>'+[1,2,3,4,5,6,7].map(n=>'<i class="'+(n===4?'bad':'good')+'">'+n+'<small>'+((n*173)%7000)+'s</small></i>').join('')+'</div></section></div><footer>资产库：开启　导航图、角色、场景、道具不会发送给模型　 <select onchange="updateScene('+i+',\'duration\',this.value)"><option '+(s.duration==10?'selected':'')+'>10</option><option '+(s.duration==15?'selected':'')+'>15</option><option '+(s.duration==30?'selected':'')+'>30</option></select>s</footer></article>').join('')}
function updateScene(i,k,v){const x=story();x[i][k]=v;persistStory(x);if(k==='duration')renderScenes()}
function newScene(){const x=story();x.push({title:'镜头_'+(x.length+1),script:'',prompt:'',duration:15,status:'ready'});persistStory(x);renderScenes()}
function duplicateScene(i){const x=story();x.splice(i+1,0,{...x[i],title:x[i].title+'_副本'});persistStory(x);renderScenes()}
function deleteScene(i){const x=story();if(x.length===1)return alert('至少保留一个镜头');x.splice(i,1);persistStory(x);renderScenes()}
function clearScene(i){updateScene(i,'script','');alert('已清空场景参考')}
function assetAction(i,a){alert(a+'面板已打开；素材选择会写入当前镜头')}
function regenerateScene(i){updateScene(i,'status','queued');alert('镜头已加入生成队列；接入上游视频 API 后开始生成')}
function downloadScene(i){const x=story()[i];const b=new Blob([JSON.stringify(x,null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download=x.title+'.json';a.click()}
function batchGenerate(){story().forEach((_,i)=>regenerateScene(i));alert('全部镜头已加入队列')}
function exportStory(){const b=new Blob([JSON.stringify(story(),null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='dola-storyboard.json';a.click()}
function importPage(){C.innerHTML='<div class="panel"><h2>Cookie Import</h2><p class="muted">支持 TXT、CSV、JSON，或直接粘贴 Cookie，每行一个。</p><textarea id="cookies2" style="width:100%;height:220px" placeholder="sessionid=...; sid_guard=..."></textarea><p><input type="file" id="file2" accept=".txt,.csv,.json"></p><button class="primary" onclick="doImport2()">开始导入</button></div>'}
async function createTask(){let r=await api('tasks',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({prompt:document.getElementById('prompt').value,model:model.value,duration:Number(duration.value),quality:quality.value,ratio:ratio.value,min_bytes:30000000})});alert(r.error||'任务已创建');render()}
async function doImport2(){let f=file2.files[0],fd=new FormData();fd.append('cookies',cookies2.value);if(f)fd.append('file',f);let r=await fetch('/api/import',{method:'POST',body:fd});alert(JSON.stringify(await r.json()));render()}
function closeModal(){modal.style.display='none'} function addRow(){alert('请使用生成页或导入页的专用表单新增数据')} nav();render();
</script>
<style>.modal>div{background:#202425;color:#e7eeee;max-width:94vw}button{cursor:pointer;background:#283334;color:#eee;border:1px solid #425354;border-radius:5px;padding:8px}table{font-size:13px}.panel{overflow:auto}td{max-width:340px;overflow-wrap:anywhere}.toolbar{flex-wrap:wrap}select,input{max-width:100%}@media(max-width:700px){aside{width:110px;padding:10px 5px}main{margin-left:110px;padding:15px}nav button{padding:12px 5px}.grid{grid-template-columns:1fr}}.empty{padding:48px;text-align:center;color:#92a6a9}</style>
<script>
function esc(x){return String(x??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'}[c]))}
const labels={id:'编号',name:'名称',cookie:'Cookie',status:'状态',points:'点数',created_at:'创建时间',host:'地址',port:'端口',username:'用户名',password:'密码',prompt:'提示词',duration:'时长',ratio:'比例',model:'模型',account_id:'账号',progress:'进度',result:'结果',quality:'目标画质',min_bytes:'目标大小',label:'名称',key:'密钥',enabled:'启用',action:'操作',detail:'详情',message:'内容',level:'级别',k:'设置项',v:'值'};
const originalRender=render;
render=async function(){
 document.querySelectorAll('nav button').forEach(b=>b.classList.toggle('active',b.dataset.page===page));
 if(page==='generate')return gen();if(page==='import')return importPage();
 try{const table=page==='keys'?'api_keys':page;const data=await api(table);if(!Array.isArray(data))throw Error(data.error||'读取失败');
 C.innerHTML='<div class="panel"><div class="toolbar"><input id="filterText" placeholder="搜索名称、任务或提示词"><select id="filterStatus"><option value="">全部状态</option></select><button id="refresh">刷新</button>'+(['accounts','proxies','keys','settings'].includes(page)?'<button id="add" class="primary">新增 / 配置</button>':'')+'<button id="export">导出 JSON</button></div><div id="listing"></div></div>';
 const states=[...new Set(data.map(r=>r.status).filter(Boolean))];document.getElementById('filterStatus').innerHTML+=states.map(x=>'<option>'+esc(x)+'</option>').join('');
 const draw=()=>{const q=document.getElementById('filterText').value.toLowerCase(),status=document.getElementById('filterStatus').value;const filtered=data.filter(r=>JSON.stringify(r).toLowerCase().includes(q)&&(!status||r.status===status));const heads=data[0]?Object.keys(data[0]):[];document.getElementById('listing').innerHTML=filtered.length?'<table><thead><tr>'+heads.map(h=>'<th>'+esc(labels[h]||h)+'</th>').join('')+(['accounts','proxies','tasks','api_keys'].includes(table)?'<th>操作</th>':'')+'</tr></thead><tbody>'+filtered.map(r=>'<tr>'+heads.map(h=>'<td>'+(h==='status'?'<span class="badge">'+esc(r[h]==='awaiting_provider'?'待接通生成服务':r[h])+'</span>':esc(r[h]))+'</td>').join('')+(['accounts','proxies','tasks','api_keys'].includes(table)?'<td><button data-delete="'+esc(r.id)+'">删除</button></td>':'')+'</tr>').join('')+'</tbody></table>':'<div class="empty">暂无匹配记录</div>';document.querySelectorAll('[data-delete]').forEach(b=>b.onclick=async()=>{if(!confirm('删除这条记录？'))return;await api(table+'/'+encodeURIComponent(b.dataset.delete),{method:'DELETE'});render()})};
 document.getElementById('filterText').oninput=draw;document.getElementById('filterStatus').onchange=draw;document.getElementById('refresh').onclick=render;
 if(document.getElementById('add'))document.getElementById('add').onclick=addRow;
 document.getElementById('export').onclick=()=>{const u=URL.createObjectURL(new Blob([JSON.stringify(data,null,2)],{type:'application/json'}));const a=document.createElement('a');a.href=u;a.download=table+'.json';a.click();setTimeout(()=>URL.revokeObjectURL(u),1000)};draw();
 }catch(e){C.innerHTML='<div class="panel">加载失败：'+esc(e.message)+'</div>'}
};
addRow=function(){if(page==='accounts'){document.getElementById('modal').style.display='flex';return}
 const fields=page==='proxies'?{host:'代理主机',port:'端口',username:'用户名',password:'密码'}:page==='keys'?{label:'名称'}:{project_name:'项目名称',global_prompt:'全局提示词'};
 C.innerHTML='<form class="panel" id="editor"><h2>'+esc(T.textContent)+'</h2>'+Object.entries(fields).map(([k,v])=>'<p><label>'+esc(v)+'<br><input name="'+k+'" '+(k==='password'?'type="password"':'')+'></label></p>').join('')+'<button class="primary">保存</button></form>';
 document.getElementById('editor').onsubmit=async e=>{e.preventDefault();const x=Object.fromEntries(new FormData(e.target));if(page==='proxies'){x.port=Number(x.port);if(!x.host||x.port<1||x.port>65535){alert('填写有效地址及端口');return}}const r=await api(page,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(x)});if(r.error){alert(r.error);return}if(r.key)alert('保存密钥，仅本次显示：'+r.key);render()};
};
doImport=async function(){const fd=new FormData();fd.append('cookies',document.getElementById('cookies').value);const f=document.getElementById('file').files[0];if(f)fd.append('file',f);try{const r=await api('import',{method:'POST',body:fd});if(r.error)throw Error(r.error);closeModal();alert('导入 '+r.count+' 条');render()}catch(e){alert(e.message)}};
render();
</script>
</body></html>'''
